# Shared develop environment values (non-secret defaults)
# Personal/team overrides: .env.dev.local

PUBLIC_TILE_SERVER_BASE_URL=https://dev.allmaps.xyz
PUBLIC_TILE_VIEWER_BASE_URL=https://dev.tiles.allmaps.org
PUBLIC_PREVIEW_BASE_URL=https://dev.preview.allmaps.org
PUBLIC_VIEWER_BASE_URL=https://dev.viewer.allmaps.org
PUBLIC_EDITOR_BASE_URL=https://dev.editor.allmaps.org
PUBLIC_HERE_BASE_URL=https://dev.here.allmaps.org
PUBLIC_LATEST_BASE_URL=https://dev.latest.allmaps.org
PUBLIC_EXPLORE_BASE_URL=https://dev.explore.allmaps.org
PUBLIC_ARCADE_BASE_URL=https://arcade.allmaps.org
PUBLIC_HOMEPAGE_BASE_URL=https://dev.allmaps.org
PUBLIC_DATA_FILES_BASE_URL=https://files.allmaps.org
PUBLIC_DOCS_BASE_URL=https://dev.docs.allmaps.org
PUBLIC_ANNOTATIONS_BASE_URL=https://dev.annotations.allmaps.org
PUBLIC_LIVE_BASE_URL=https://dev.live.allmaps.org
PUBLIC_REST_BASE_URL=https://dev.api.allmaps.org

PUBLIC_STATS_WEBSITE_ID=
PUBLIC_GEOCODE_EARTH_KEY=

PUBLIC_BANNER_ENABLED=true
PUBLIC_BANNER_TEXT=This is the development version!

NODE_VERSION=24
SECURE=true

DATABASE_URL=
LOG_QUERIES=false

BETTER_AUTH_URL=https://dev.api.allmaps.org
BETTER_AUTH_SECRET=
BETTER_AUTH_COOKIE_PREFIX=allmaps-dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

USE_CACHE=true
BROWSER_CACHE_HOURS=1
CLOUDFLARE_CACHE_HOURS=1
