{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "collage",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "build",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": false
    }
  },
  "env": {
    "dev": {
      "name": "collage-develop"
    }
  }
}
