---
import { MapExample } from '@allmaps/ui/examples'
import type { MapExampleProps } from '@allmaps/ui/examples'
import { exampleCode, exampleLibraries } from '@allmaps/ui/examples/source'
import { renderCode } from '@allmaps/ui/code/renderer'
import codeTheme from 'virtual:allmaps-code-theme'

export type Props = MapExampleProps
const props = Astro.props as Props

const library = props.library ?? 'MapLibre'
const source = exampleCode(props, library, exampleLibraries[library].packages)
const languages = ['javascript', 'html', 'bash'] as const
const [javascript, html, bash] = await Promise.all(
  languages.map((language) => renderCode({
    code: source[language],
    language,
    theme: codeTheme
  }))
)
const initialCode = { javascript, html, bash }
---

<MapExample {...props} codeTheme={codeTheme} initialCode={initialCode} client:visible />
