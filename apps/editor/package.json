{
  "name": "@allmaps/editor",
  "version": "2.0.0-alpha.13",
  "private": true,
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "apps/editor"
  },
  "scripts": {
    "dev": "vite dev --mode localhost",
    "build": "vite build",
    "lerna-build": "lerna run build --scope @allmaps/editor --include-dependencies",
    "deploy": "node ../../scripts/wrangler-deploy.ts --cwd . --dotenv-file ../../.env.production --dotenv-file ../../.env.production.local",
    "deploy:dev": "node ../../scripts/wrangler-deploy.ts --cwd . --wrangler-env dev --dotenv-file ../../.env.dev --dotenv-file ../../.env.dev.local",
    "tail": "wrangler tail",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "types": "tsc --noEmit",
    "lint": "prettier --ignore-path ../../.gitignore --check . && eslint .",
    "format": "prettier  --ignore-path ../../.gitignore --write ."
  },
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/basemap": "workspace:^",
    "@allmaps/env": "workspace:^",
    "@allmaps/id": "workspace:^",
    "@allmaps/iiif-inspector": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/io": "workspace:^",
    "@allmaps/maplibre": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/ui": "workspace:^",
    "@turf/rewind": "catalog:",
    "bits-ui": "catalog:",
    "d3-geo": "catalog:",
    "driver.js": "^1.6.0",
    "js-sha1": "^0.7.0",
    "lodash-es": "catalog:",
    "maplibre-gl": "catalog:",
    "ot-json1": "catalog:",
    "pmtiles": "catalog:",
    "reconnecting-websocket": "^4.4.0",
    "sharedb": "catalog:",
    "sharedb-client-browser": "^5.2.2",
    "shiki": "^3.13.0",
    "terra-draw": "^1.25.1",
    "terra-draw-maplibre-gl-adapter": "^1.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@allmaps/types": "workspace:^",
    "@eslint/js": "catalog:",
    "@inlang/paraglide-js": "^2.20.2",
    "@inlang/plugin-m-function-matcher": "^2.2.6",
    "@inlang/plugin-message-format": "^4.4.0",
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/d3-geo": "catalog:",
    "@types/diff-match-patch": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/sharedb": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "phosphor-svelte": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "catalog:",
    "wrangler": "catalog:"
  }
}
