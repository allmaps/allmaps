{
  "name": "@allmaps/here",
  "version": "1.0.0-beta.44",
  "private": true,
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "apps/here"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --mode localhost",
    "dev-ssl": "SSL=true NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev --host --mode localhost",
    "build": "vite build",
    "lerna-build": "lerna run build --scope @allmaps/here --include-dependencies",
    "deploy": "node ../../scripts/wrangler-deploy.ts --cwd . --dotenv-file ../../.env.production --dotenv-file ../../.env.production.local",
    "deploy:dev": "node ../../scripts/wrangler-deploy.ts --cwd . --wrangler-env dev --dotenv-file ../../.env.dev --dotenv-file ../../.env.dev.local",
    "tail": "wrangler tail",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --ignore-path ../../.gitignore --check . && eslint .",
    "format": "prettier --ignore-path ../../.gitignore --write src",
    "types": "tsc --noEmit",
    "cert": "mkdir .cert && mkcert -key-file ./.cert/key.pem -cert-file ./.cert/cert.pem 'localhost'"
  },
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/bearing": "workspace:^",
    "@allmaps/env": "workspace:^",
    "@allmaps/iiif-inspector": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/ui": "workspace:^",
    "@turf/distance": "^7.2.0",
    "bits-ui": "catalog:",
    "lodash-es": "catalog:",
    "ol": "catalog:",
    "phosphor-svelte": "catalog:"
  },
  "devDependencies": {
    "@allmaps/types": "workspace:^",
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@turf/length": "^7.2.0",
    "@types/lodash-es": "catalog:",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "catalog:",
    "vite-plugin-qrcode": "^0.2.4",
    "wrangler": "catalog:"
  }
}
