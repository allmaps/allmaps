{
  "name": "@allmaps/homepage",
  "description": "Allmaps Homepage",
  "version": "1.0.0-beta.32",
  "private": true,
  "contributors": [
    {
      "name": "Bert Spaan",
      "email": "hello@bertspaan.nl",
      "url": "https://bertspaan.nl"
    },
    {
      "name": "Manuel Claeys Bouuaert",
      "email": "manuel.claeys.b@gmail.com",
      "url": "https://manuelclaeysbouuaert.be"
    }
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "apps/homepage"
  },
  "homepage": "https://allmaps.org",
  "keywords": [
    "allmaps",
    "homepage",
    "website"
  ],
  "license": "MIT",
  "scripts": {
    "blog:manifest": "node --experimental-strip-types ./scripts/generate-blog-manifest.ts",
    "dev": "pnpm run blog:manifest && vite dev --mode localhost",
    "start": "pnpm run dev",
    "check": "pnpm run blog:manifest && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm run blog:manifest && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build": "pnpm run blog:manifest && vite build",
    "lerna-build": "lerna run build --scope @allmaps/homepage --include-dependencies",
    "preview": "vite preview",
    "types": "tsc --noEmit",
    "lint": "prettier --ignore-path ../../.gitignore --check . && eslint .",
    "format": "prettier --ignore-path ../../.gitignore --write ."
  },
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/latest": "workspace:^",
    "@allmaps/maplibre": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/ui": "workspace:^",
    "@turf/rewind": "^7.2.0",
    "bits-ui": "catalog:",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "catalog:",
    "phosphor-svelte": "catalog:",
    "pmtiles": "catalog:",
    "protomaps-themes-base": "2.0.0-alpha.5"
  },
  "devDependencies": {
    "@allmaps/types": "workspace:^",
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "mdsvex": "^0.12.7",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "catalog:"
  }
}
