{
  "name": "@allmaps/homepage",
  "description": "Allmaps Homepage",
  "version": "1.0.0-beta.33",
  "private": true,
  "contributors": [
    {
      "name": "Bert Spaan",
      "email": "hello@bertspaan.nl",
      "url": "https://bertspaan.nl"
    },
    {
      "name": "Manuel Claeys Bouuaert",
      "email": "manuel.claeys.b@gmail.com",
      "url": "https://manuelclaeysbouuaert.be"
    }
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "apps/homepage"
  },
  "homepage": "https://allmaps.org",
  "keywords": [
    "allmaps",
    "homepage",
    "website"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --mode localhost",
    "start": "pnpm run dev",
    "check": "svelte-kit sync --mode localhost && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync --mode localhost && svelte-check --tsconfig ./tsconfig.json --watch",
    "build": "vite build",
    "lerna-build": "lerna run build --scope @allmaps/homepage --include-dependencies",
    "preview": "vite preview",
    "screenshots": "node ../../tools/screenshots/src/cli.ts",
    "types": "tsc --noEmit",
    "lint": "prettier --ignore-path ../../.gitignore --check . && eslint .",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "test": "vitest run",
    "screenshots:responsive": "node scripts/generate-screenshot-images.ts",
    "hero:masks": "node scripts/generate-hero-masks.ts",
    "homepage:masks": "node scripts/generate-homepage-masks.ts",
    "map-data:preview": "node scripts/generate-map-data-preview.ts",
    "partners:previews": "node scripts/generate-partner-previews.ts",
    "images:upload": "node scripts/upload-images.ts",
    "build:dev": "vite build --mode dev && node --env-file=../../.env.dev scripts/prepare-cloudflare.ts",
    "deploy:dev": "pnpm --workspace-root exec wrangler deploy --config apps/homepage/wrangler.jsonc",
    "build:production": "vite build --mode production && node --env-file=../../.env.production scripts/prepare-cloudflare.ts",
    "deploy:production": "pnpm --workspace-root exec wrangler deploy --config apps/homepage/wrangler.jsonc --env production"
  },
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/maplibre": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/ui": "workspace:^",
    "@turf/rewind": "catalog:",
    "bits-ui": "catalog:",
    "d3-geo": "catalog:",
    "maplibre-gl": "catalog:",
    "phosphor-svelte": "catalog:",
    "pmtiles": "catalog:",
    "protomaps-themes-base": "2.0.0-alpha.5"
  },
  "devDependencies": {
    "@allmaps/screenshots": "workspace:^",
    "@allmaps/types": "workspace:^",
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/d3-geo": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "mdsvex": "^0.12.7",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-cloudflare-quick-tunnel": "^0.2.0",
    "vite-plugin-devtools-json": "catalog:",
    "vitest": "catalog:"
  }
}
