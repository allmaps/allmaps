{
  "name": "@allmaps/viewer",
  "version": "1.0.0-beta.88",
  "private": true,
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "apps/viewer"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=32768' vite dev --mode localhost",
    "build": "vite build",
    "lerna-build": "lerna run build --scope @allmaps/viewer --include-dependencies",
    "deploy": "node ../../scripts/wrangler-deploy.ts --cwd . --dotenv-file ../../.env.production --dotenv-file ../../.env.production.local",
    "deploy:dev": "node ../../scripts/wrangler-deploy.ts --cwd . --wrangler-env dev --dotenv-file ../../.env.dev --dotenv-file ../../.env.dev.local",
    "tail": "wrangler tail",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "types": "tsc --noEmit",
    "lint": "prettier --ignore-path ../../.gitignore --check . && eslint .",
    "format": "prettier --ignore-path ../../.gitignore --write ."
  },
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/background-color": "workspace:^",
    "@allmaps/basemap": "workspace:^",
    "@allmaps/bearing": "workspace:^",
    "@allmaps/env": "workspace:^",
    "@allmaps/id": "workspace:^",
    "@allmaps/iiif-inspector": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/maplibre": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/render": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/ui": "workspace:^",
    "bits-ui": "catalog:",
    "comlink": "^4.4.1",
    "lodash-es": "catalog:",
    "maplibre-gl": "catalog:",
    "simplify-js": "^1.2.4"
  },
  "devDependencies": {
    "@allmaps/types": "workspace:^",
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "phosphor-svelte": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
