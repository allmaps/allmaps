{
  "name": "@allmaps/allmaps",
  "type": "module",
  "private": true,
  "scripts": {
    "watch": "turbo watch build --filter \"./packages/**\" --filter \"./apis/**\"",
    "watch:apps": "turbo watch build --filter \"{./apps/**}^...\"",
    "watch:packages": "turbo watch build --filter \"./packages/**\"",
    "init": "pnpm install --recursive && pnpm run build:packages && pnpm run check && pnpm run build:apps",
    "init:apps": "pnpm install --recursive && turbo run build --filter \"{./apps/**}^...\" && turbo run check --filter \"./apps/**\"",
    "init:packages": "pnpm install --recursive && pnpm run build:packages && turbo run check --filter \"./packages/**\"",
    "dev:apps": "pnpm --parallel --filter \"./apps/**\" run dev",
    "dev:packages": "pnpm --parallel --filter \"./packages/**\" run dev",
    "types": "turbo run types",
    "types:packages": "turbo run types --filter \"./packages/**\"",
    "types:packages:force": "turbo run types --force --filter \"./packages/**\"",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter \"./packages/**\"",
    "build:packages:force": "turbo run build --force --filter \"./packages/**\"",
    "build:apps": "turbo run build --filter \"./apps/**\"",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "documentation": "turbo run documentation",
    "precommit": "turbo run precommit",
    "remove-tsbuildinfo": "find . -maxdepth 3 -name \"tsconfig.tsbuildinfo\" -type f -delete",
    "remove-vite-timestamp": "find . -maxdepth 3 -name \"vite.config.*.timestamp-*\" -type f -delete",
    "remove-node-modules": "find . -name node_modules -type d -prune -exec trash {} +",
    "reset": "pnpm run remove-tsbuildinfo && pnpm run remove-vite-timestamp && pnpm run remove-node-modules && pnpm run init",
    "prepare": "husky install",
    "version-prerelease": "lerna version prerelease",
    "publish-beta": "pnpm run publish --dist-tag beta",
    "publish": "npm whoami && lerna publish from-git",
    "publish-resume": "npm whoami && npm_lifecycle_event=publish lerna publish from-package",
    "dev:apis": "pnpm build:apis && node tools/apis/src/cli.ts",
    "db:generate": "pnpm --filter @allmaps/db run db:generate",
    "db:migrate": "node tools/apis/src/cli.ts migrate",
    "build:apis": "turbo run build --filter=@allmaps/api-rest... --filter=@allmaps/api-annotations... --filter=@allmaps/api-live...",
    "test:apis": "pnpm --filter @allmaps/test-apis test",
    "test:release": "node --test scripts/api-release.test.ts",
    "types:apis": "pnpm --filter @allmaps/db --filter @allmaps/api-shared --filter @allmaps/api-rest --filter @allmaps/api-annotations --filter @allmaps/api-live --filter @allmaps/tools-apis --filter @allmaps/test-apis run types",
    "types:release": "pnpm --filter @allmaps/db exec tsc --project ../../scripts/tsconfig.release.json",
    "setup:env": "node tools/setup/src/setup.ts"
  },
  "devDependencies": {
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@lerna-lite/run": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "turbo": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
