{
  "name": "@allmaps/analyze",
  "version": "1.0.0-beta.13",
  "author": {
    "name": "Manuel Claeys Bouuaert",
    "email": "manuel.claeys.b@gmail.com",
    "url": "https://manuelclaeysbouuaert.be"
  },
  "description": "Allmaps Analysis Library",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "packages/analyze"
  },
  "homepage": "https://allmaps.org",
  "keywords": [
    "allmaps",
    "analyze",
    "georeference",
    "map"
  ],
  "scripts": {
    "watch": "tsc --watch --noCheck",
    "build": "tsc --noCheck",
    "test": "NODE_ENV=test vitest run",
    "lint": "prettier --ignore-path ../../.gitignore --check src test && eslint src test --ext .js,.ts",
    "format": "prettier --ignore-path ../../.gitignore --write src test",
    "types": "tsc --noEmit",
    "documentation": "documentation readme dist/index.js --section=API"
  },
  "license": "MIT",
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/render": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/types": "workspace:^",
    "ml-matrix": "catalog:",
    "ml-ransac": "^1.0.0",
    "point-in-polygon-hao": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "documentation": "^14.0.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
