{
  "name": "@allmaps/components",
  "version": "1.0.0-beta.8",
  "contributors": [
    {
      "name": "Bert Spaan",
      "email": "hello@bertspaan.nl",
      "url": "https://bertspaan.nl"
    },
    {
      "name": "Manuel Claeys Bouuaert",
      "email": "manuel.claeys.b@gmail.com",
      "url": "https://manuelclaeysbouuaert.be"
    }
  ],
  "description": "Svelte components for Allmaps",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "git+https://github.com/allmaps/allmaps.git",
    "directory": "packages/components"
  },
  "scripts": {
    "dev": "vite dev --mode localhost",
    "watch": "svelte-package --watch",
    "build": "vite build && pnpm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "lint": "prettier --ignore-path ../../.gitignore --check src && eslint src --ext .ts,.svelte",
    "types": "tsc --noEmit"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "svelte": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "svelte": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "svelte": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./geocoder": "./dist/geocoder.js",
    "./projections": "./dist/projections.js",
    "./css/*": "./dist/css/*"
  },
  "peerDependencies": {
    "@sveltejs/kit": "catalog:",
    "svelte": "catalog:"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/types": "workspace:^",
    "@turf/rewind": "^7.2.0",
    "better-auth": "catalog:",
    "bits-ui": "catalog:",
    "d3-geo": "^3.1.1",
    "flatbush": "^4.4.0",
    "fuse.js": "^7.1.0",
    "lodash-es": "^4.17.21",
    "phosphor-svelte": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/d3-geo": "^3.1.0",
    "@types/lodash-es": "^4.17.6",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "publint": "^0.3.2",
    "svelte": "catalog:",
    "svelte-check": "^4.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.0.0"
  }
}
