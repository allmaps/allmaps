  },
  "homepage": "https://allmaps.org",
  "keywords": [
    "allmaps",
    "iiif",
    "parser"
  ],
  "scripts": {
    "watch": "tsc --watch --noCheck",
    "build": "tsc --noCheck",
    "types": "tsc --noEmit",
