{
  "name": "@allmaps/io",
  "version": "1.0.0-beta.5",
  "contributors": [
    {
      "name": "Bert Spaan",
      "email": "hello@bertspaan.nl",
      "url": "https://bertspaan.nl"
    },
    {
      "name": "Manuel Claeys Bouuaert",
      "email": "manuel.claeys.b@gmail.com",
      "url": "https://manuelclaeysbouuaert.be"
    }
  ],
  "description": "Import properties and export derivatives of Georeference Annotations",
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "packages/io"
  },
  "homepage": "https://allmaps.org",
  "keywords": [
    "allmaps",
    "io"
  ],
  "scripts": {
    "watch": "tsc --watch --noCheck",
    "build": "tsc --noCheck",
    "types": "tsc --noEmit",
    "documentation": "remark . --output --use remark-api",
    "lint": "prettier --ignore-path ../../.gitignore --check src && eslint src --ext .js,.ts",
    "format": "prettier --ignore-path ../../.gitignore --write src"
  },
  "license": "MIT",
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/id": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/types": "workspace:^",
    "proj4": "catalog:",
    "stream-json": "catalog:"
  },
  "devDependencies": {
    "@types/stream-json": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "remark-api": "catalog:",
    "remark-cli": "catalog:",
    "typescript": "catalog:"
  }
}
