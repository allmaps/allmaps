{
  "name": "@allmaps/tailwind",
  "version": "1.0.0-beta.22",
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "description": "Allmaps Tailwind CSS presets",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./index.css",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./ui.css": "./ui.css",
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "*.css",
    "preset.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "packages/tailwind"
  },
  "homepage": "https://allmaps.org",
  "keywords": [
    "allmaps",
    "tailwind",
    "css"
  ],
  "scripts": {
    "watch": "turbo watch build --filter=@allmaps/tailwind",
    "build": "tsc --noCheck && node dist/write-palette.js",
    "lint": "prettier --ignore-path ../../.gitignore --check src && eslint src --ext .js,.ts",
    "types": "tsc --noEmit",
    "format": "prettier --ignore-path ../../.gitignore --write src",
    "documentation": "remark . --output --use remark-api"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "remark-api": "catalog:",
    "remark-cli": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
