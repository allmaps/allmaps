{
  "name": "@allmaps/ui",
  "version": "1.0.0-beta.43",
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "description": "UI components and functions for Allmaps",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "svelte"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "svelte": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "svelte": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "svelte": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./geocoder": "./dist/geocoder.js",
    "./projections": "./dist/projections.js",
    "./css/*": "./dist/css/*"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allmaps/allmaps.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "dev": "vite dev --mode localhost",
    "watch": "svelte-package --watch",
    "prepare": "svelte-kit sync || echo ''",
    "build": "vite build && pnpm run prepack",
    "preview": "vite preview",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "lint": "prettier --ignore-path ../../.gitignore --check src && eslint src --ext .ts,.svelte",
    "types": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/d3-geo": "catalog:",
    "@types/lodash-es": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": "catalog:",
    "svelte": "catalog:"
  },
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/types": "workspace:^",
    "@turf/rewind": "catalog:",
    "better-auth": "catalog:",
    "bits-ui": "catalog:",
    "d3-geo": "catalog:",
    "flatbush": "^4.4.0",
    "fuse.js": "^7.1.0",
    "lodash-es": "catalog:",
    "phosphor-svelte": "catalog:"
  }
}
