{
  "name": "@allmaps/ui",
  "version": "1.0.0-beta.44",
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "description": "UI components and functions for Allmaps",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "svelte"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./button": {
      "types": "./dist/button.d.ts",
      "svelte": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./screenshots/integration": {
      "types": "./dist/screenshots-integration.d.ts",
      "default": "./dist/screenshots-integration.js"
    },
    "./screenshots": {
      "types": "./dist/screenshots.d.ts",
      "default": "./dist/screenshots.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "svelte": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "svelte": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "svelte": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./geocoder": "./dist/geocoder.js",
    "./projections": "./dist/projections.js",
    "./css/*": "./dist/css/*",
    "./select": {
      "types": "./dist/select.d.ts",
      "svelte": "./dist/select.js",
      "default": "./dist/select.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "svelte": "./dist/code.js",
      "default": "./dist/code.js"
    },
    "./code/renderer": {
      "types": "./dist/code/renderer.d.ts",
      "default": "./dist/code/renderer.js"
    },
    "./examples/source": {
      "types": "./dist/examples/source.d.ts",
      "default": "./dist/examples/source.js"
    },
    "./latest": {
      "types": "./dist/latest.d.ts",
      "svelte": "./dist/latest.js",
      "default": "./dist/latest.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "svelte": "./dist/dialog.js",
      "default": "./dist/dialog.js"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu.d.ts",
      "svelte": "./dist/dropdown-menu.js",
      "default": "./dist/dropdown-menu.js"
    },
    "./kbd": {
      "types": "./dist/kbd.d.ts",
      "svelte": "./dist/kbd.js",
      "default": "./dist/kbd.js"
    },
    "./north-arrow": {
      "types": "./dist/north-arrow.d.ts",
      "svelte": "./dist/north-arrow.js",
      "default": "./dist/north-arrow.js"
    },
    "./opacity-slider": {
      "types": "./dist/opacity-slider.d.ts",
      "svelte": "./dist/opacity-slider.js",
      "default": "./dist/opacity-slider.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "svelte": "./dist/checkbox.js",
      "default": "./dist/checkbox.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "svelte": "./dist/toggle.js",
      "default": "./dist/toggle.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "svelte": "./dist/tooltip.js",
      "default": "./dist/tooltip.js"
    },
    "./star-toggle": {
      "types": "./dist/star-toggle.d.ts",
      "svelte": "./dist/star-toggle.js",
      "default": "./dist/star-toggle.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allmaps/allmaps.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "dev": "astro dev --mode localhost",
    "watch": "svelte-package --watch",
    "build": "pnpm run prepack",
    "preview": "astro preview",
    "prepack": "svelte-package && publint",
    "check": "astro check --tsconfig ./tsconfig.styleguide.json && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "lint": "prettier --ignore-path ../../.gitignore --check src && eslint src --ext .ts,.svelte",
    "types": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build:styleguide": "astro build",
    "deploy:production": "wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/starlight": "^0.42.4",
    "@astrojs/starlight-tailwind": "^4.0.0",
    "@astrojs/svelte": "^9.0.1",
    "@eslint/js": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/d3-geo": "catalog:",
    "@types/geojson": "catalog:",
    "@types/leaflet": "catalog:",
    "@types/lodash-es": "catalog:",
    "@typescript/native": "catalog:",
    "astro": "^7.3.5",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "dependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/id": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/leaflet": "workspace:^",
    "@allmaps/maplibre": "workspace:^",
    "@allmaps/openlayers": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/render": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/types": "workspace:^",
    "@turf/rewind": "catalog:",
    "@ui-sdk/core": "0.1.0-beta.14",
    "@ui-sdk/svelte": "0.1.0-beta.14",
    "bits-ui": "catalog:",
    "clsx": "^2.1.1",
    "d3-geo": "catalog:",
    "flatbush": "^4.4.0",
    "fuse.js": "^7.1.0",
    "leaflet": "catalog:",
    "lodash-es": "catalog:",
    "maplibre-gl": "catalog:",
    "ol": "catalog:",
    "phosphor-svelte": "catalog:",
    "shiki": "4.4.3",
    "tailwind-merge": "^3.7.1"
  }
}
