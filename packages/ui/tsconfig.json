{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "references": [
    { "path": "../annotation" },
    { "path": "../bearing" },
    { "path": "../iiif-parser" },
    { "path": "../id" },
    { "path": "../project" },
    { "path": "../render" },
    { "path": "../stdlib" },
    { "path": "../transform" },
    { "path": "../types" }
  ],
  "include": [
    "src/lib/**/*",
    "src/components/**/*",
    "test/**/*",
    "svelte.config.js"
  ],
  "exclude": ["dist", "build", "node_modules"]
}
