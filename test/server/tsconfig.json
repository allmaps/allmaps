{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "test/**/*.ts",
    "svelte.config.js",
    "vite.config.ts"
  ],
  "references": [
    { "path": "../../packages/annotation" },
    { "path": "../../packages/iiif-parser" },
    { "path": "../../packages/id" },
    { "path": "../../packages/tailwind" },
    { "path": "../../packages/transform" }
  ]
}
