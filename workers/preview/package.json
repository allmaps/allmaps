{
  "name": "@allmaps/preview",
  "version": "1.0.0-beta.20",
  "description": "Allmaps Preview",
  "private": true,
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "main": "./src/index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "workers/preview"
  },
  "scripts": {
    "deploy": "node ../../scripts/wrangler-deploy.ts --cwd . --dotenv-file ../../.env.production --dotenv-file ../../.env.production.local",
    "deploy:dev": "node ../../scripts/wrangler-deploy.ts --cwd . --wrangler-env dev --dotenv-file ../../.env.dev --dotenv-file ../../.env.dev.local",
    "dev": "wrangler dev --port $(../../port.js preview) --env dev --env-file ../../.env.localhost --env-file ../../.env.localhost.local",
    "build": "tsc",
    "lerna-build": "lerna run build --scope @allmaps/preview --include-dependencies",
    "cf-typegen": "wrangler types",
    "lint": "prettier --ignore-path ../../.gitignore --check src && eslint src --ext .js,.ts",
    "types": "tsc --noEmit",
    "format": "prettier --ignore-path ../../.gitignore --write src"
  },
  "license": "MIT",
  "devDependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/env": "workspace:^",
    "@allmaps/frame": "workspace:^",
    "@allmaps/id": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/render": "workspace:^",
    "@allmaps/render-wasm": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/tailwind": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/types": "workspace:^",
    "@cloudflare/kv-asset-handler": "catalog:",
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "@turf/rewind": "catalog:",
    "@types/d3-geo": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/tinycolor2": "^1.4.3",
    "@types/upng-js": "catalog:",
    "autoprefixer": "^10.4.21",
    "d3-geo": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "itty-router": "catalog:",
    "jpeg-js": "catalog:",
    "prettier": "catalog:",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinycolor2": "^1.6.0",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "upng-js": "catalog:",
    "wrangler": "catalog:"
  }
}
