{
  "name": "@allmaps/tileserver",
  "version": "1.0.0-beta.80",
  "description": "Allmaps Tile Server",
  "private": true,
  "author": {
    "name": "Bert Spaan",
    "email": "hello@bertspaan.nl",
    "url": "https://bertspaan.nl"
  },
  "main": "./src/index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/allmaps/allmaps.git",
    "directory": "workers/tileserver"
  },
  "scripts": {
    "lerna-build": "lerna run build --scope @allmaps/tileserver --include-dependencies",
    "deploy": "node ../../scripts/wrangler-deploy.ts --cwd . --dotenv-file ../../.env.production --dotenv-file ./.env.override --dotenv-file ../../.env.production.local",
    "deploy:dev": "node ../../scripts/wrangler-deploy.ts --cwd . --wrangler-env dev --dotenv-file ../../.env.dev --dotenv-file ./.env.override --dotenv-file ../../.env.dev.local",
    "dev": "wrangler dev --port $(../../port.js tileserver) --env dev --env-file ../../.env.localhost --env-file ./.env.override --env-file ../../.env.localhost.local",
    "lint": "prettier --ignore-path ../../.gitignore --check src test scripts && eslint src test scripts --ext .js,.ts",
    "cf-typegen": "wrangler types",
    "types": "tsc --noEmit",
    "format": "prettier --ignore-path ../../.gitignore --write src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx scripts/benchmark.ts",
    "compare": "tsx scripts/compare-outputs.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@allmaps/annotation": "workspace:^",
    "@allmaps/env": "workspace:^",
    "@allmaps/id": "workspace:^",
    "@allmaps/iiif-parser": "workspace:^",
    "@allmaps/project": "workspace:^",
    "@allmaps/render": "workspace:^",
    "@allmaps/render-wasm": "workspace:^",
    "@allmaps/stdlib": "workspace:^",
    "@allmaps/transform": "workspace:^",
    "@allmaps/types": "workspace:^",
    "@cloudflare/kv-asset-handler": "catalog:",
    "@types/node": "catalog:",
    "@types/pixelmatch": "^5.2.6",
    "@types/upng-js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "itty-router": "catalog:",
    "jpeg-js": "catalog:",
    "pixelmatch": "^5.3.0",
    "prettier": "catalog:",
    "tsx": "^4.19.2",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "upng-js": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
